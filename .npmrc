# Electron / Chromium prebuilt binaries are fetched from GitHub Releases.
# On networks where github.com is unreachable (common in mainland China) the
# postinstall step fails with ECONNRESET / ETIMEDOUT and the desktop app cannot
# start. Point @electron/get at a mirror instead; override with
# ELECTRON_MIRROR when you have direct GitHub access.
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
