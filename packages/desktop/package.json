{
  "name": "@robrowser/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop host for RoboBrowser",
  "author": "RoboBrowser",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.main.json --noEmit && node scripts/build-main.mjs && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "package": "pnpm build && electron-builder --config electron-builder.yml",
    "clean": "rimraf dist release",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/build-main.mjs && electron .",
    "postinstall": "node scripts/rebuild-native.mjs"
  },
  "dependencies": {
    "better-sqlite3": "11.9.1",
    "pino": "^9.3.1"
  },
  "devDependencies": {
    "@robrowser/browser": "workspace:*",
    "@robrowser/core": "workspace:*",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^30.2.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "zod": "^3.23.8"
  }
}
